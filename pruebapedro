local player = game.Players.LocalPlayer

local gui = script.Parent
local circle = gui:WaitForChild("CircleButton")
local panel = gui:WaitForChild("AdminPanel")

local closeBtn = panel:WaitForChild("CloseBtn")
local minBtn = panel:WaitForChild("MinBtn")

local speedBtn = panel:WaitForChild("SpeedBtn")
local jumpBtn = panel:WaitForChild("JumpBtn")

-- ajustes
local DEFAULT_SPEED = 16
local DEFAULT_JUMP = 50
local SPEED_BOOST = 225
local JUMP_BOOST = 100

local speedOn = false
local jumpOn = false

----------------------------------------------------------------
-- MAKE ELEMENTS DRAGGABLE
----------------------------------------------------------------
local UserInputService = game:GetService("UserInputService")

local function makeDraggable(frame)
	local dragging = false
	local dragStart, startPos

	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
end

makeDraggable(panel)
makeDraggable(circle)

----------------------------------------------------------------
-- CÍRCULO ABRE/CERRA PANEL
----------------------------------------------------------------
circle.MouseButton1Click:Connect(function()
	panel.Visible = not panel.Visible
end)

----------------------------------------------------------------
-- BOTÓN CERRAR
----------------------------------------------------------------
closeBtn.MouseButton1Click:Connect(function()
	panel.Visible = false
	circle.Visible = false
end)

----------------------------------------------------------------
-- BOTÓN MINIMIZAR
----------------------------------------------------------------
minBtn.MouseButton1Click:Connect(function()
	panel.Visible = false
	circle.Visible = true
end)

----------------------------------------------------------------
-- VELOCIDAD
----------------------------------------------------------------
speedBtn.MouseButton1Click:Connect(function()
	speedOn = not speedOn
	speedBtn.Text = speedOn and "Velocidad [ON]" or "Velocidad [OFF]"

	local hum = player.Character and player.Character:FindFirstChildWhichIsA("Humanoid")
	if hum then
		hum.WalkSpeed = speedOn and SPEED_BOOST or DEFAULT_SPEED
	end
end)

----------------------------------------------------------------
-- SALTO
----------------------------------------------------------------
jumpBtn.MouseButton1Click:Connect(function()
	jumpOn = not jumpOn
	jumpBtn.Text = jumpOn and "Salto [ON]" or "Salto [OFF]"

	local hum = player.Character and player.Character:FindFirstChildWhichIsA("Humanoid")
	if hum then
		hum.JumpPower = jumpOn and JUMP_BOOST or DEFAULT_JUMP
	end
end)

----------------------------------------------------------------
-- REAPLICAR AL RESPAWN
----------------------------------------------------------------
player.CharacterAdded:Connect(function(char)
	task.wait(0.2)
	local hum = char:WaitForChild("Humanoid")

	hum.WalkSpeed = speedOn and SPEED_BOOST or DEFAULT_SPEED
	hum.JumpPower = jumpOn and JUMP_BOOST or DEFAULT_JUMP
end)

